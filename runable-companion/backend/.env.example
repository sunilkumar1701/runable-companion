# AgentRouter API Configuration
AGENT_ROUTER_API_KEY=your_agent_router_api_key_here
AGENT_ROUTER_BASE_URL=https://co.agentrouter.org/v1
AGENT_ROUTER_MODEL=openai/gpt-6.1-sol

# Server Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Token & Context Optimization
CHAT_MAX_OUTPUT_TOKENS=500
SUMMARY_MAX_OUTPUT_TOKENS=700
CHAT_HISTORY_LIMIT=6
MAX_PAGE_CONTEXT_CHARS=8000

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

