{
  "manifest_version": 3,
  "name": "Runable Companion",
  "version": "1.2.1",
  "description": "Your AI-powered browser companion for summarizing pages, creating slides, reports, and more.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage",
    "commands",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "commands": {
    "open-runable-side-panel": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Open Runable Companion side panel"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  }
}
